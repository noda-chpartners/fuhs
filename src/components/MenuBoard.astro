---
import type { MenuGroup } from '../data/shop';

interface Props {
	groups: MenuGroup[];
	notes?: string[];
}

const { groups, notes = [] } = Astro.props;
---

<div class="menu-board">
	{
		groups.map((group) => (
			<section class="menu-group" data-reveal>
				<h3>{group.label}</h3>
				<ul>
					{group.items.map((item) => (
						<li>
							<span class="menu-name">{item.name}{item.description && <small>{item.description}</small>}</span>
							<span class:list={['menu-price', { 'menu-price-text': !/^[\d,]+$/.test(item.price) }]}>
								{item.price}
								{/^[\d,]+$/.test(item.price) && <span class="yen">円</span>}
							</span>
						</li>
					))}
				</ul>
				{group.note && <p class="menu-group-note">{group.note}</p>}
			</section>
		))
	}
</div>
{
	notes.length > 0 && (
		<ul class="menu-notes" data-reveal>
			{notes.map((note) => (
				<li>{note}</li>
			))}
		</ul>
	)
}
