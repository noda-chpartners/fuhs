---
interface Props {
	name: 'clock' | 'calendar' | 'scissors' | 'train' | 'phone' | 'pin' | 'instagram';
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
	{
		name === 'clock' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<path d="M12 8.5V12l2.5 2" />
			</>
		)
	}
	{
		name === 'calendar' && (
			<>
				<rect x="4" y="5.5" width="16" height="14" rx="2" />
				<path d="M8 3.5v4M16 3.5v4M4 10h16" />
			</>
		)
	}
	{
		name === 'scissors' && (
			<>
				<circle cx="7" cy="7" r="2.2" />
				<circle cx="7" cy="17" r="2.2" />
				<path d="M8.8 8.6 20 18M8.8 15.4 20 6" />
			</>
		)
	}
	{
		name === 'train' && (
			<>
				<rect x="6" y="3.5" width="12" height="13" rx="2.5" />
				<path d="M6 11.5h12M8 20l2.2-3.5h3.6L16 20" />
				<circle cx="9" cy="14.2" r="0.7" fill="currentColor" stroke="none" />
				<circle cx="15" cy="14.2" r="0.7" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'phone' && (
			<path d="M8.2 4.8h2.1l1.2 3-1.5 1a12 12 0 0 0 5.2 5.2l1-1.5 3 1.2v2.1a1.6 1.6 0 0 1-1.7 1.6A14.2 14.2 0 0 1 6.6 6.5a1.6 1.6 0 0 1 1.6-1.7Z" />
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" />
				<circle cx="12" cy="11" r="2" />
			</>
		)
	}
	{
		name === 'instagram' && (
			<>
				<rect x="4" y="4" width="16" height="16" rx="4" />
				<circle cx="12" cy="12" r="3.4" />
				<circle cx="16.6" cy="7.4" r="0.7" fill="currentColor" stroke="none" />
			</>
		)
	}
</svg>
