---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	caption: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="menu-visual" data-reveal>
	<Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 880px) 540px, 100vw" quality={85} />
	<figcaption>{caption}</figcaption>
</figure>
