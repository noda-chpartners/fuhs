---
import { Image, getImage } from 'astro:assets';
import wordmark from '../assets/images/logo-wordmark.png';
import hero from '../assets/images/IMG_2697.jpg';
import Icon from './Icon.astro';
import { shop } from '../data/shop';

const heroBackground = await getImage({ src: hero, format: 'webp', quality: 85 });
---

<section class="hero" id="top" aria-label="Fuhs 美容ルームとテイクアウトカフェ">
	<div class="hero-background" style={{ backgroundImage: `url("${heroBackground.src}")` }} aria-hidden="true"></div>
	<div class="container hero-grid">
		<div class="hero-copy">
			<h1 class="hero-logo-wrap" data-hero>
				<Image
					src={wordmark}
					alt=""
					widths={[480, 840, 1200]}
					sizes="(min-width: 880px) 42vw, 88vw"
					quality={90}
					loading="eager"
					class="hero-logo"
				/>
				<span class="sr-only">町田市鶴川の美容ルーム・カフェ ==Fuhs==</span>
			</h1>
			<p class="hero-lead" data-hero>美容ルームと、<br />テイクアウトカフェ。</p>
			<div class="hero-actions" data-hero>
				<a class="btn btn-primary" href={shop.telHref}>
					<Icon name="phone" />
					電話で予約する
				</a>
				<a class="btn btn-line" href="#hair">メニューを見る</a>
			</div>
		</div>
	</div>
	<a class="hero-scroll" href="#about" aria-label="スクロールしてごあいさつへ">お店について <span aria-hidden="true">↓</span></a>
</section>
<div class="hero-info" aria-label="営業時間と店舗情報">
	<div class="container">
		<ul class="facts">
			<li data-reveal>
				<Icon name="clock" />
				<span>営業</span>
				<strong>{shop.hours}</strong>
			</li>
			<li data-reveal>
				<Icon name="scissors" />
				<span>美容受付</span>
				<strong>{shop.reception}まで</strong>
			</li>
			<li data-reveal>
				<Icon name="calendar" />
				<span>定休日</span>
				<strong>{shop.closed}</strong>
			</li>
			<li data-reveal>
				<Icon name="train" />
				<span>最寄駅</span>
				<strong>鶴川駅 {shop.walk}</strong>
			</li>
		</ul>
	</div>
</div>
