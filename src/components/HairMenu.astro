---
import { Image } from 'astro:assets';
import interior from '../assets/images/IMG_2698.jpg';
import MenuBoard from './MenuBoard.astro';
import { hairMenu, hairNotes } from '../data/shop';
---

<section class="section section-warm" id="hair" aria-labelledby="hair-title">
	<div class="container">
		<header class="section-head" data-reveal>
			<p class="section-index">02</p>
			<p class="section-kicker">Hair Cut room</p>
			<h2 id="hair-title">気負わない、まちの美容室。</h2>
		</header>
		<p class="lead" data-reveal>
			カットからカラー、パーマ、マニキュアまで。ご予約はお電話でお願いしています。美容ルームの受付は17:00までです。
		</p>
		<figure class="hair-figure" data-reveal>
			<Image
				src={interior}
				alt="カットチェアと木の床がある、明るい美容ルームの店内"
				widths={[640, 960, 1400]}
				sizes="(min-width: 880px) 1080px, 100vw"
				quality={78}
			/>
		</figure>
		<MenuBoard groups={hairMenu} notes={hairNotes} />
	</div>
</section>
