---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import HairMenu from '../components/HairMenu.astro';
import PhotoBand from '../components/PhotoBand.astro';
import CafeMenu from '../components/CafeMenu.astro';
import Refa from '../components/Refa.astro';
import Access from '../components/Access.astro';
import Reserve from '../components/Reserve.astro';
import Footer from '../components/Footer.astro';
import { shop } from '../data/shop';

const title = '鶴川の美容ルーム・カフェ ==Fuhs==｜町田市';
const description =
	'町田市鶴川の美容ルーム・テイクアウトカフェ==Fuhs==。自家製ミートソースとスイーツCaffe。Minced meat and sweet cafe。鶴川駅徒歩25分、横浜銀行前。9:30〜、月曜定休。予約 042-733-3811。';

const pageUrl = new URL('/', Astro.site ?? Astro.url).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': ['HairSalon', 'CafeOrCoffeeShop'],
	'@id': `${pageUrl}#business`,
	name: shop.name,
	alternateName: ['フーズ', 'Fuhs', 'Hair Cut room Fuhs'],
	description,
	url: pageUrl,
	image: new URL('/ogp.jpg', Astro.site ?? Astro.url).href,
	telephone: '+81-42-733-3811',
	address: {
		'@type': 'PostalAddress',
		postalCode: '195-0061',
		addressRegion: '東京都',
		addressLocality: '町田市',
		streetAddress: '鶴川2丁目14-13',
		addressCountry: 'JP',
	},
	areaServed: '東京都町田市鶴川',
	hasMap: shop.map,
	sameAs: ['https://www.instagram.com/fuhs_hair_cafe/'],
};
---

<Base title={title} description={description}>
	<Header />
	<main id="main">
		<Hero />
		<About />
		<HairMenu />
		<Refa />
		<PhotoBand />
		<CafeMenu />
		<Access />
		<Reserve />
	</main>
	<Footer />
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
